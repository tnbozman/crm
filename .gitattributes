# Auto-detect text files; normalize to LF on checkout
* text=auto eol=lf

# C# source
*.cs        text eol=lf
*.csx       text eol=lf

# Project and build files
*.csproj    text eol=lf
*.sln       text eol=lf
*.slnx      text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.xml       text eol=lf
*.config    text eol=lf

# Web
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.vue       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf

# Data
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf

# Docs
*.md        text eol=lf
*.txt       text eol=lf
*.editorconfig text eol=lf

# Shell
*.sh        text eol=lf
Makefile    text eol=lf

# Bicep
*.bicep     text eol=lf
*.bicepparam text eol=lf

# Binary — never diff or merge
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       text eol=lf
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.pdf       binary
*.zip       binary
*.7z        binary
*.gz        binary
*.tar       binary
