<Project Sdk="Microsoft.NET.Sdk">

  <!-- A module (ADR-013): references only Crm.SharedKernel and Crm.Mediator, never another module. -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- make migration-add uses this project as the dotnet-ef startup project; it does not ship. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Crm.SharedKernel\Crm.SharedKernel.csproj" />
    <ProjectReference Include="..\..\Crm.Mediator\Crm.Mediator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Crm.__Module__.Tests" />
  </ItemGroup>

</Project>
