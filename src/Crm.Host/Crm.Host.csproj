<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Build-time OpenAPI document: only when asked (make api-client passes GenerateOpenApi=true). -->
  <PropertyGroup>
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <OpenApiGenerateDocuments Condition="'$(GenerateOpenApi)' == 'true'">true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)../../openapi</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crm.Platform\Crm.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Crm.Host.Tests" />
    <InternalsVisibleTo Include="Crm.Architecture.Tests" />
  </ItemGroup>

  <!-- The Vue app (src/web) is built into wwwroot by dotnet build. Skip with -p:SkipFrontend=true. -->
  <PropertyGroup>
    <FrontendDir>$(MSBuildThisFileDirectory)..\web\</FrontendDir>
    <SkipFrontend Condition="'$(SkipFrontend)' == ''">false</SkipFrontend>
  </PropertyGroup>

  <ItemGroup>
    <FrontendInputs Include="$(FrontendDir)src\**;$(FrontendDir)index.html;$(FrontendDir)package.json;$(FrontendDir)pnpm-lock.yaml;$(FrontendDir)vite.config.ts;$(FrontendDir)tsconfig*.json" />
  </ItemGroup>

  <!-- wwwroot is generated by BuildFrontend after evaluation, so its hashed files must not be static web assets:
       MSBuild would track the previous build's file names and fail once Vite replaces them. The host serves wwwroot
       from disk (UseStaticFiles); publish includes it via the SDK's _IncludePrePublishGeneratedContent (S0-7). -->
  <ItemGroup>
    <Content Remove="wwwroot\**" />
  </ItemGroup>

  <Target Name="BuildFrontend" BeforeTargets="BeforeBuild" Condition="'$(SkipFrontend)' != 'true'"
          Inputs="@(FrontendInputs)" Outputs="$(MSBuildProjectDirectory)\wwwroot\index.html">
    <Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="$(FrontendDir)" />
    <Exec Command="pnpm run build" WorkingDirectory="$(FrontendDir)" />
  </Target>

</Project>
